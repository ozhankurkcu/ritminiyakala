rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isActivityCreator(activityId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/activities/$(activityId)).data.createdBy == request.auth.uid;
    }

    // ===== USERS =====
    match /users/{userId} {
      // Sadece kendi profilini oku
      allow read: if isOwner(userId);

      // Kayıt sırasında kendi profilini oluştur
      allow create: if isOwner(userId)
        && request.resource.data.email == request.auth.token.email
        && !("role" in request.resource.data)
        && request.resource.data.status == "active";

      // Kendi profilini güncelle (email ve role değiştirilemez)
      allow update: if isOwner(userId)
        && !("email" in request.resource.data.diff.affectedKeys())
        && !("role" in request.resource.data.diff.affectedKeys());

      // Soft delete — sadece kendi hesabı
      allow delete: if isOwner(userId);
    }

    // ===== ACTIVITIES =====
    match /activities/{activityId} {
      // Herkes okuyabilir (keşfet sayfası)
      allow read: if true;

      // Giriş yapmış kullanıcı aktivite oluşturabilir
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.maxParticipants >= 2
        && request.resource.data.maxParticipants <= 100
        && request.resource.data.startTime > request.time
        && request.resource.data.keys().hasAll(["title", "sportType", "location", "startTime", "createdBy"]);

      // Sadece oluşturan kişi güncelleyebilir (createdBy değiştirilemez)
      allow update: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid
        && !("createdBy" in request.resource.data.diff.affectedKeys());

      // Sadece oluşturan kişi silebilir
      allow delete: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid;

      // ===== PARTICIPANTS =====
      match /participants/{participantId} {
        // Herkes katılımcı listesini görebilir
        allow read: if true;

        // Kullanıcı sadece kendini ekleyebilir, tekrar eklenemez
        allow create: if isAuthenticated()
          && participantId == request.auth.uid
          && !exists(/databases/$(database)/documents/activities/$(activityId)/participants/$(request.auth.uid))
          && request.resource.data.status == "pending";

        // Kullanıcı kendi durumunu güncelleyebilir VEYA aktivite sahibi onaylayabilir/reddedebilir
        allow update: if isAuthenticated()
          && (participantId == request.auth.uid || isActivityCreator(activityId));

        // Kullanıcı kendini çıkarabilir VEYA aktivite sahibi çıkarabilir
        allow delete: if isAuthenticated()
          && (participantId == request.auth.uid || isActivityCreator(activityId));
      }
    }

    // ===== FALLBACK — diğer her şey kapalı =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
