rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profil fotoğrafları — avatars/{userId}/avatar.*
    match /avatars/{userId}/{fileName} {
      // Herkes profil fotoğrafını görebilir
      allow read: if true;

      // Sadece kendi fotoğrafını yükleyebilir/silebilir
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024        // maks 5MB
        && request.resource.contentType.matches('image/.*'); // sadece görsel
    }

    // Aktivite görselleri — activities/{activityId}/{fileName}
    match /activities/{activityId}/{fileName} {
      allow read: if true;

      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Diğer her şey kapalı
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
